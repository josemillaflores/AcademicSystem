{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Information"
      }
    }
  },
  "Auth": {
    "Authority": "https://localhost:7001",
    "Audience": "academic_api",
    "Issuer": "academic_auth",
    "SecretKey": "your-super-secret-key-with-at-least-32-characters-long"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowInSeconds": 60,
    "QueueLimit": 10
  },
  "ReverseProxy": {
    "Routes": {
      "students-route": {
        "ClusterId": "students-cluster",
        "Match": {
          "Path": "/gateway/students/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/students/{**catch-all}" }
        ],
        "AuthorizationPolicy": "academic-api-policy"
      },
      "teachers-route": {
        "ClusterId": "teachers-cluster",
        "Match": {
          "Path": "/gateway/teachers/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/teachers/{**catch-all}" }
        ]
      },
      "courses-route": {
        "ClusterId": "courses-cluster",
        "Match": {
          "Path": "/gateway/courses/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/courses/{**catch-all}" }
        ]
      },
      "enrollments-route": {
        "ClusterId": "enrollments-cluster",
        "Match": {
          "Path": "/gateway/enrollments/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/enrollments/{**catch-all}" }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/gateway/payments/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/payments/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "students-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://studentservice:8080/"
          }
        }
      },
      "teachers-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://teacherservice:8080/"
          }
        }
      },
      "courses-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://courseservice:8080/"
          }
        }
      },
      "enrollments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://enrollmentservice:8080/"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://paymentservice:8080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}