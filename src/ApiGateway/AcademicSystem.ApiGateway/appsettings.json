{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Auth": {
    "Authority": "https://localhost:7001",
    "Audience": "academic_api",
    "Issuer": "academic_auth",
    "SecretKey": "your-super-secret-key-with-at-least-32-characters-long"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowInSeconds": 60,
    "QueueLimit": 10
  },
  "ReverseProxy": {
    "Routes": {
      "students-route": {
        "ClusterId": "students-cluster",
        "Match": {
          "Path": "/gateway/students/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/students/{**catch-all}" }
        ],
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "fixed",
        "Order": 1
      },
      "teachers-route": {
        "ClusterId": "teachers-cluster",
        "Match": {
          "Path": "/gateway/teachers/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/teachers/{**catch-all}" }
        ],
        "AuthorizationPolicy": "default",
        "Order": 2
      },
      "courses-route": {
        "ClusterId": "courses-cluster",
        "Match": {
          "Path": "/gateway/courses/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/courses/{**catch-all}" }
        ],
        "AuthorizationPolicy": "default",
        "Order": 3
      },
      "enrollments-route": {
        "ClusterId": "enrollments-cluster",
        "Match": {
          "Path": "/gateway/enrollments/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/enrollments/{**catch-all}" }
        ],
        "AuthorizationPolicy": "default",
        "Order": 4
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/gateway/payments/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [
          { "PathPattern": "/api/v1/payments/{**catch-all}" }
        ],
        "AuthorizationPolicy": "default",
        "Order": 5
      },
      "health-route": {
        "ClusterId": "aggregator-cluster",
        "Match": {
          "Path": "/health/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/health/{**catch-all}" }
        ],
        "Order": 0
      }
    },
    "Clusters": {
      "students-cluster": {
        "Destinations": {
          "student1": {
            "Address": "http://studentservice:8080/",
            "HealthCheck": "https://studentservice:8081/health"
          },
          "student2": {
            "Address": "http://studentservice2:8080/",
            "HealthCheck": "https://studentservice2:8081/health"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures"
          },
          "Passive": {
            "Enabled": true,
            "ReactivationPeriod": "00:01:00"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:30"
        }
      },
      "teachers-cluster": {
        "Destinations": {
          "teacher1": {
            "Address": "http://teacherservice:8080/"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05"
          }
        }
      },
      "courses-cluster": {
        "Destinations": {
          "course1": {
            "Address": "http://courseservice:8080/"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "enrollments-cluster": {
        "Destinations": {
          "enrollment1": {
            "Address": "http://enrollmentservice:8080/"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "payment1": {
            "Address": "http://paymentservice:8080/"
          }
        }
      },
      "aggregator-cluster": {
        "Destinations": {
          "aggregator1": {
            "Address": "http://localhost:8080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}